@using Shop_Toshmatovv.Data.Models
@using Shop_Toshmatovv.Data.ViewModell
@model VMItems

@{
    ViewBag.Title = "Список товаров";
    Layout = "_Layout";
}

<div style="margin-top: 20px; margin-bottom: 20px;">
    <div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
        <div>
            <select onchange="SelectCategory(this)" style="padding: 5px; width: 180px;">
                <option value="0">Все категории</option>
                @foreach (var category in Model.Categorys)
                {
                    if (category.Id == Model.SelectCategory)
                    {
                        <option selected="selected" value="@category.Id">@category.Name</option>
                    }
                    else
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                }
            </select>
        </div>

        <div>
            <a href="@Url.Action("List", new { id = Model.SelectCategory, sortOrder = "asc", searchString = Model.SearchString })"
               style="margin-right: 5px; padding: 5px 10px; background: @(Model.SortOrder == "asc" ? "#007bff" : "#f0f0f0"); color: @(Model.SortOrder == "asc" ? "white" : "black"); text-decoration: none; border-radius: 3px;">
                ↑ По возрастанию
            </a>
            <a href="@Url.Action("List", new { id = Model.SelectCategory, sortOrder = "desc", searchString = Model.SearchString })"
               style="padding: 5px 10px; background: @(Model.SortOrder == "desc" ? "#007bff" : "#f0f0f0"); color: @(Model.SortOrder == "desc" ? "white" : "black"); text-decoration: none; border-radius: 3px;">
                ↓ По убыванию
            </a>
        </div>

        <a href="/Items/Add"
           style="background: #28a745; color: white; padding: 6px 15px; text-decoration: none; border-radius: 3px; font-weight: bold;">
            + Добавить
        </a>
    </div>
</div>

<script>
    function SelectCategory(sender) {
        window.location = "/Items/List?id=" + sender.value + "&sortOrder=@Model.SortOrder&searchString=@Model.SearchString";
    }
</script>

<h2>Все предметы</h2>

@if (!Model.Items.Any())
{
    <p>Ничего не найдено</p>
}
else
{
    @foreach (var item in Model.Items)
    {
        if (Model.SelectCategory == 0 || item.Categorys.Id == Model.SelectCategory)
        {
            <div class="item" style="border: 1px solid #ccc; margin: 10px 0; padding: 10px; display: flex; gap: 20px;">
                @if (!string.IsNullOrEmpty(item.Img))
                {
                    string imagePath = item.Img.StartsWith("/") ? item.Img : "/Images/" + item.Img;
                    <img src="@imagePath" alt="@item.Name" style="max-width: 200px; max-height: 200px;"
                         onerror="this.onerror=null; this.src='/Images/no-image.png';" />
                }
                else
                {
                    <img src="/Images/no-image.png" alt="Нет изображения" style="max-width: 200px; max-height: 200px;" />
                }
                
                <div style="flex: 1;">
                    <h3>@item.Name</h3>
                    <p><strong>Цена:</strong> @item.Price.ToString("C")</p>
                    <p><strong>Категория:</strong> @item.Categorys?.Name</p>
                    <p><strong>Описание:</strong> @item.Description</p>

                    <div style="display: flex; align-items: center; gap: 10px; margin-top: 15px; flex-wrap: wrap;">
                        <div class="basket" style="display: flex; align-items: center;">
                            <button class="btn-basket" data-id="@item.Id" style="background: #007bff; color: white; border: none; padding: 8px 20px; border-radius: 3px; cursor: pointer; white-space: nowrap;">
                                В корзину
                            </button>
                            <div class="count" style="display: none; align-items: center; gap: 2px;">
                                <button class="btn-min" data-id="@item.Id" style="background: #6c757d; color: white; border: none; width: 30px; height: 30px; border-radius: 3px; cursor: pointer;">-</button>
                                <span class="text" style="min-width: 20px; text-align: center;">1</span>
                                <button class="btn-max" data-id="@item.Id" style="background: #6c757d; color: white; border: none; width: 30px; height: 30px; border-radius: 3px; cursor: pointer;">+</button>
                            </div>
                        </div>

                        <a href="/Items/Update/@item.Id" style="background: #ffc107; padding: 8px 20px; text-decoration: none; color: black; border-radius: 3px;">Изменить</a>
                        <a href="/Items/Delete/@item.Id" onclick="return confirm('Удалить?')" style="background: #dc3545; padding: 8px 20px; text-decoration: none; color: white; border-radius: 3px;">Удалить</a>
                    </div>
                </div>
            </div>
        }
    }
}

<!--Подключение JQuer -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function() {
        $.get('@Url.Action("GetBasketCount", "Items")', function(count) {
            $('#basketCount').text(count);
        });

        $(".btn-basket").click(function() {
            var button = $(this);
            var basketDiv = button.closest('.basket');
            var countDiv = basketDiv.find('.count');
            var itemId = button.data('id');

            button.hide();

            countDiv.css('display', 'flex');

            $.ajax({
                url: '@Url.Action("Basket", "Items")',
                type: 'POST',
                data: { idItem: itemId },
                success: function(data) {
                    console.log("Товар добавлен в корзину:", data);
                    $.get('@Url.Action("GetBasketCount", "Items")', function(count) {
                        $('#basketCount').text(count);
                    });
                },
                error: function(xhr, status, error) {
                    console.log("Ошибка добавления:", error);
                }
            });
        });

        $(".btn-max").click(function() {
            var button = $(this);
            var countDiv = button.closest('.count');
            var textSpan = countDiv.find('.text');
            var itemId = button.data('id');
            var count = parseInt(textSpan.text());

            count++;
            textSpan.text(count);

            $.ajax({
                url: '@Url.Action("BasketCount", "Items")',
                type: 'POST',
                data: {
                    idItem: itemId,
                    count: count
                },
                success: function(data) {
                    console.log("Количество обновлено:", data);
                    $.get('@Url.Action("GetBasketCount", "Items")', function(count) {
                        $('#basketCount').text(count);
                    });
                },
                error: function(xhr, status, error) {
                    console.log("Ошибка обновления:", error);
                }
            });
        });

        $(".btn-min").click(function() {
            var button = $(this);
            var countDiv = button.closest('.count');
            var textSpan = countDiv.find('.text');
            var basketDiv = button.closest('.basket');
            var itemId = button.data('id');
            var count = parseInt(textSpan.text());

            count--;

            if (count == 0) {
                basketDiv.find('.btn-basket').show();
                countDiv.hide();
            } else {
                textSpan.text(count);
            }

            $.ajax({
                url: '@Url.Action("BasketCount", "Items")',
                type: 'POST',
                data: {
                    idItem: itemId,
                    count: count
                },
                success: function(data) {
                    console.log("Количество обновлено:", data);

                    $.get('@Url.Action("GetBasketCount", "Items")', function(count) {
                        $('#basketCount').text(count);
                    });
                },
                error: function(xhr, status, error) {
                    console.log("Ошибка обновления:", error);
                }
            });
        });
    });
</script>