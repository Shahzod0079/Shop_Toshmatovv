@using Shop_Toshmatovv.Data.Models
@model IEnumerable<Items>

@{
    ViewBag.Title = ViewBag.CategoryName;
    Layout = "_Layout";
    var categoryId = ViewBag.CategoryId;
}

<div style="margin-top: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2>@(ViewBag.CategoryName ?? "Категория")</h2>

        <div style="display: flex; gap: 10px;">
            <a href="/Items/Add?categoryId=@(categoryId ?? 0)"
               style="background: #28a745; color: white; padding: 8px 20px; text-decoration: none; border-radius: 3px;">
                + Добавить товар
            </a>

            <a href="@Url.Action("Index")" style="background: #6c757d; color: white; padding: 8px 15px; text-decoration: none; border-radius: 3px;">
                ← Назад
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <p>В этой категории пока нет товаров</p>
    }
    else
    {
        foreach (var item in Model)
        {
            <div style="border: 1px solid #ccc; margin: 10px 0; padding: 10px; display: flex; gap: 20px;">
                @if (!string.IsNullOrEmpty(item.Img))
                {
                    string imagePath = item.Img.StartsWith("/") ? item.Img : "/Images/" + item.Img;
                    <img src="@imagePath" alt="@item.Name" style="max-width: 200px; max-height: 200px;" />
                }
                <div style="flex: 1;">
                    <h3>@item.Name</h3>
                    <p><strong>Цена:</strong> @item.Price.ToString("C")</p>
                    <p><strong>Категория:</strong> @(item.Categorys?.Name ?? "Неизвестно")</p>
                    <p><strong>Описание:</strong> @item.Description</p>

                    <!-- ДОБАВЛЕННЫЕ КНОПКИ -->
                    <div style="margin-top: 15px;">
                        <a href="/Items/Update/@item.Id?categoryId=@categoryId"
                           style="background: #ffc107; color: black; padding: 8px 20px; text-decoration: none; border-radius: 3px; margin-right: 10px; display: inline-block;">
                            Изменить
                        </a>
                        <a href="/Items/Delete/@item.Id?categoryId=@categoryId"
                           onclick="return confirm('Удалить товар @item.Name?')"
                           style="background: #dc3545; color: white; padding: 8px 20px; text-decoration: none; border-radius: 3px; display: inline-block;">
                            Удалить
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>