<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="../css/ViewBag.Title.css" />
    <title>@ViewBag.Title</title>
    <!-- Подключение jQuery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>
</head>
<body>
    <div class="header">
        <img src="/images/location_14790627.png" />

        <form method="get" action="@Url.Action("List", "Items")" style="display: flex; align-items: center; margin-left: 20px;">
            <input class="search" name="searchString" placeholder="Поиск по сайту"
                   value="@(ViewBag.CurrentSearch ?? "")"
                   style="width: 300px; padding: 8px; border: 1px solid #ddd; border-radius: 3px 0 0 3px; outline: none;" />
            <button type="submit" style="padding: 8px 20px; background: #28a745; color: white; border: none; border-radius: 0 3px 3px 0; cursor: pointer; font-weight: bold; margin-left: 10px">
                Найти
            </button>
        </form>

        <div class="nav-links">
            <a href="@Url.Action("List", "Items")" class="nav-link">Все товары</a>
            <a href="@Url.Action("Index", "Categories")" class="nav-link">Категории</a>
        </div>

        <img class="basket" src="/images/shopping_16454496.png" />
    </div>

    @RenderBody()
</body>
</html>