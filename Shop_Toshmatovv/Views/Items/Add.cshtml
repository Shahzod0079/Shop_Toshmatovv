@using Shop_Toshmatovv.Data.Models
@model IEnumerable<Categorys>

@{
    Layout = "_Layout";
}

<div class="add-form">
    <h2>Добавление товара</h2>

    <form method="post" enctype="multipart/form-data" id="addForm">
        <div class="form-group">
            <label class="required">Наименование:</label>
            <input type="text" name="name" placeholder="Введите наименование" required />
        </div>

        <div class="form-group">
            <label class="required">Описание:</label>
            <textarea name="description" placeholder="Введите описание" rows="4" required></textarea>
        </div>

        <div class="form-group">
            <label>Изображение:</label>
            <input type="file" name="files" accept="image/*" />
        </div>

        <div class="form-row">
            <div class="form-group half">
                <label class="required">Стоимость (₽):</label>
                <input type="number" name="price" placeholder="0" min="0" required />
            </div>

            <div class="form-group half">
                <label class="required">Категория:</label>
                <select name="idCategory" required>
                    @foreach (var category in Model)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="button-group">
            <button type="submit" class="btn-submit" id="submitBtn">Добавить</button>

            <a href="@(ViewBag.CategoryId != null ? Url.Action("List", "Categories", new { id = ViewBag.CategoryId }) : Url.Action("List", "Items"))"
               class="btn-cancel">
                Отмена
            </a>
        </div>
    </form>
</div>

