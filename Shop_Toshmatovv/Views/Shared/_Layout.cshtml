<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="/css/Style.css" />
    <title>@ViewBag.Title</title>
</head>
<body>
    <div class="header">
        <img src="/images/location_14790627.png" />

        <input class="search" placeholder="Поиск по сайту" />

        <div class="nav-links">
            <a href="@Url.Action("List", "Items")" class="nav-link">Все товары</a>
            <a href="@Url.Action("Index", "Categories")" class="nav-link">Категории</a>
        </div>

        <img class="basket" src="/images/shopping_16454496.png" />
    </div>

    @RenderBody()
</body>
</html>